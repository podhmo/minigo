{
	"$defs": {
		"Base": {
			"additionalProperties": true,
			"description": "Wrapper embeds a same-package struct — its fields flatten.",
			"properties": {
				"base_id": {
					"type": "string"
				}
			},
			"required": [
				"base_id"
			],
			"type": "object"
		},
		"Commented": {
			"additionalProperties": true,
			"description": "Commented covers the comment positions a description can come from:\na doc comment above the field and a line comment at its end.",
			"properties": {
				"bare": {
					"type": "integer"
				},
				"both": {
					"description": "Both is described twice — the doc comment wins in inspect's\nfieldDoc order.",
					"type": "integer"
				},
				"lead": {
					"description": "Lead is described by the comment above it.",
					"type": "integer"
				},
				"trail": {
					"description": "Trail is described by the trailing comment only.",
					"type": "integer"
				}
			},
			"required": [
				"bare",
				"both",
				"lead",
				"trail"
			],
			"type": "object"
		},
		"Custom": {
			"additionalProperties": true,
			"description": "Custom is a type the jsonschema-override tag can decorate.",
			"properties": {
				"level": {
					"maximum": 5,
					"minimum": 1,
					"type": "integer"
				}
			},
			"required": [
				"level"
			],
			"type": "object"
		},
		"ID": {
			"description": "ID aliases string — an alias def renders as a $ref-shaped alias.",
			"type": "string"
		},
		"Interval": {
			"additionalProperties": true,
			"description": "Interval is a half-open time range — its fields are standard-library\ntypes, the stdlib-leaf boundary the walk is expected to stop at.",
			"properties": {
				"end": {
					"description": "stdlib type time.Time (walk stopped)"
				},
				"start": {
					"description": "stdlib type time.Time (walk stopped)"
				}
			},
			"required": [
				"end",
				"start"
			],
			"type": "object"
		},
		"Money": {
			"additionalProperties": true,
			"description": "Money is an amount in minor units with its currency.",
			"properties": {
				"amount": {
					"description": "Amount in the smallest currency unit.",
					"type": "integer"
				},
				"currency": {
					"description": "Currency code, e.g. \"JPY\".",
					"type": "string"
				}
			},
			"required": [
				"amount",
				"currency"
			],
			"type": "object"
		},
		"Pair": {
			"additionalProperties": true,
			"description": "Pair declares two names in one field spec — both become properties.",
			"properties": {
				"A": {
					"type": "string"
				},
				"B": {
					"type": "string"
				},
				"C": {
					"type": "integer"
				},
				"D": {
					"type": "integer"
				}
			},
			"required": [
				"A",
				"B"
			],
			"type": "object"
		},
		"Shadow": {
			"additionalProperties": true,
			"description": "Shadow exercises the shallower-wins rule: its explicit base_id field\nmust shadow the one promoted from Base, not be overwritten by it.",
			"properties": {
				"base_id": {
					"type": "string"
				}
			},
			"required": [
				"base_id"
			],
			"type": "object"
		},
		"Status": {
			"description": "Status is the account status.",
			"enum": [
				"active",
				"paused",
				"deleted"
			],
			"type": "string"
		},
		"Tree": {
			"additionalProperties": true,
			"description": "Tree is a recursive type in the entry package.",
			"properties": {
				"label": {
					"type": "string"
				},
				"left": {
					"$ref": "#/$defs/Tree"
				},
				"right": {
					"$ref": "#/$defs/Tree"
				}
			},
			"required": [
				"label"
			],
			"type": "object"
		},
		"User": {
			"additionalProperties": true,
			"description": "User is the root fixture type.",
			"properties": {
				"active": {
					"$ref": "#/$defs/Interval"
				},
				"address": {
					"additionalProperties": true,
					"properties": {
						"city": {
							"type": "string"
						},
						"zip": {
							"type": "string"
						}
					},
					"required": [
						"city",
						"zip"
					],
					"type": "object"
				},
				"admin": {
					"type": "boolean"
				},
				"age": {
					"type": "integer"
				},
				"amount": {
					"description": "Amount in the smallest currency unit.",
					"type": "integer"
				},
				"balance": {
					"$ref": "#/$defs/Money"
				},
				"created_at": {
					"description": "stdlib type time.Time (walk stopped)"
				},
				"currency": {
					"description": "Currency code, e.g. \"JPY\".",
					"type": "string"
				},
				"email": {
					"type": "string"
				},
				"friends": {
					"items": {
						"$ref": "#/$defs/User"
					},
					"type": "array"
				},
				"id": {
					"$ref": "#/$defs/ID"
				},
				"metadata": {
					"additionalProperties": {
						"type": "string"
					},
					"type": "object"
				},
				"name": {
					"type": "string"
				},
				"scores": {
					"items": {
						"type": "number"
					},
					"type": "array"
				},
				"status": {
					"$ref": "#/$defs/Status"
				}
			},
			"required": [
				"active",
				"address",
				"admin",
				"age",
				"balance",
				"created_at",
				"id",
				"metadata",
				"name",
				"scores",
				"status"
			],
			"type": "object"
		},
		"Wrapper": {
			"additionalProperties": true,
			"properties": {
				"base_id": {
					"type": "string"
				},
				"note": {
					"type": "string"
				}
			},
			"required": [
				"base_id",
				"note"
			],
			"type": "object"
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#"
}

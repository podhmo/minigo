{
	"$defs": {
		"Ambig": {
			"additionalProperties": true,
			"description": "Ambig promotes Y from both embeds at the same depth: encoding/json\ndrops *both*, so the schema must not pick a winner.",
			"properties": {},
			"type": "object"
		},
		"Base": {
			"additionalProperties": true,
			"description": "Wrapper embeds a same-package struct — its fields flatten.",
			"properties": {
				"base_id": {
					"type": "string"
				}
			},
			"required": [
				"base_id"
			],
			"type": "object"
		},
		"Bin": {
			"contentEncoding": "base64",
			"description": "Bin is a named slice of bytes: elements of []Bin are themselves\nbase64 strings on the wire, while the outer slice stays an array.",
			"type": "string"
		},
		"Blobbed": {
			"additionalProperties": true,
			"description": "Blobbed covers the byte-slice spellings: builtin and named byte\nelements marshal as base64, a named slice-of-bytes element stays an\narray of base64 strings, and a fixed array keeps the array shape.",
			"properties": {
				"chained": {
					"contentEncoding": "base64",
					"type": "string"
				},
				"data": {
					"contentEncoding": "base64",
					"type": "string"
				},
				"data2": {
					"contentEncoding": "base64",
					"type": "string"
				},
				"fixed": {
					"items": {
						"minimum": 0,
						"type": "integer"
					},
					"type": "array"
				},
				"marshaled": {
					"items": {
						"$ref": "#/$defs/ByteM"
					},
					"type": "array"
				},
				"moneys": {
					"items": {
						"$ref": "#/$defs/Money"
					},
					"type": "array"
				},
				"raw": {
					"contentEncoding": "base64",
					"type": "string"
				},
				"subs": {
					"items": {
						"$ref": "#/$defs/Bin"
					},
					"type": "array"
				},
				"texted": {
					"items": {
						"$ref": "#/$defs/ByteT"
					},
					"type": "array"
				}
			},
			"required": [
				"chained",
				"data",
				"data2",
				"fixed",
				"marshaled",
				"moneys",
				"raw",
				"subs",
				"texted"
			],
			"type": "object"
		},
		"Byte": {
			"description": "Byte is a named uint8: encoding/json marshals []Byte as base64, the\nsame wire shape as []byte.",
			"minimum": 0,
			"type": "integer"
		},
		"Byte2": {
			"$ref": "#/$defs/Byte",
			"description": "Byte2 adds one hop to the named-byte chase."
		},
		"Byte2M": {
			"$ref": "#/$defs/ByteM",
			"description": "Byte2M chains to a marshaling type — `type Byte2M ByteM` has no\nmethods of its own, so []Byte2M keeps the base64 shape."
		},
		"ByteM": {
			"description": "ByteM is a named byte whose pointer marshals itself: gc escapes the\n[]byte base64 shortcut when the element (or its pointer) implements\njson.Marshaler — []ByteM is an array of marshaled elements.",
			"minimum": 0,
			"type": "integer"
		},
		"ByteT": {
			"description": "ByteT marshals elements through encoding.TextMarshaler — the same\nbase64 escape as MarshalJSON.",
			"minimum": 0,
			"type": "integer"
		},
		"Code": {
			"description": "Code is an int code; the enumcode plugin overrides it with an\ninteger fragment carrying enum + numeric bounds.",
			"type": "integer"
		},
		"Commented": {
			"additionalProperties": true,
			"description": "Commented covers the comment positions a description can come from:\na doc comment above the field and a line comment at its end.",
			"properties": {
				"bare": {
					"type": "integer"
				},
				"both": {
					"description": "Both is described twice — the doc comment wins in inspect's\nfieldDoc order.",
					"type": "integer"
				},
				"lead": {
					"description": "Lead is described by the comment above it.",
					"type": "integer"
				},
				"lid": {
					"description": "Lids keeps a word that merely shares the field name's prefix —\na naive strip would leave \"s keeps...\".",
					"type": "integer"
				},
				"trail": {
					"description": "Trail is described by the trailing comment only.",
					"type": "integer"
				}
			},
			"required": [
				"bare",
				"both",
				"lead",
				"lid",
				"trail"
			],
			"type": "object"
		},
		"Custom": {
			"additionalProperties": true,
			"description": "Custom is a type the jsonschema-override tag can decorate.",
			"properties": {
				"level": {
					"maximum": 5,
					"minimum": 1,
					"type": "integer"
				}
			},
			"required": [
				"level"
			],
			"type": "object"
		},
		"DeepX": {
			"additionalProperties": true,
			"description": "DeepX promotes X one level further inside an embed chain.",
			"properties": {
				"X": {
					"type": "string"
				}
			},
			"required": [
				"X"
			],
			"type": "object"
		},
		"DepthClash": {
			"additionalProperties": true,
			"description": "DepthClash gets X from both ViaDeepX (depth 2) and ShallowX\n(depth 1): the strictly shallower promotion wins — an int.",
			"properties": {
				"X": {
					"type": "integer"
				}
			},
			"required": [
				"X"
			],
			"type": "object"
		},
		"ID": {
			"description": "ID aliases string — an alias def renders as a $ref-shaped alias.",
			"type": "string"
		},
		"Interval": {
			"additionalProperties": true,
			"description": "Interval is a half-open time range — its fields are standard-library\ntypes, the stdlib-leaf boundary the walk is expected to stop at.",
			"properties": {
				"end": {
					"description": "stdlib type time.Time (walk stopped)"
				},
				"start": {
					"description": "stdlib type time.Time (walk stopped)"
				}
			},
			"required": [
				"end",
				"start"
			],
			"type": "object"
		},
		"Label": {
			"description": "Label is a string; the enumcode plugin overrides it with a string\nenum fragment.",
			"type": "string"
		},
		"LeftY": {
			"additionalProperties": true,
			"properties": {
				"Y": {
					"type": "string"
				}
			},
			"required": [
				"Y"
			],
			"type": "object"
		},
		"Money": {
			"additionalProperties": true,
			"description": "Money is an amount in minor units with its currency.",
			"properties": {
				"amount": {
					"description": "Amount in the smallest currency unit.",
					"type": "integer"
				},
				"currency": {
					"description": "Currency code, e.g. \"JPY\".",
					"type": "string"
				}
			},
			"required": [
				"amount",
				"currency"
			],
			"type": "object"
		},
		"Pair": {
			"additionalProperties": true,
			"description": "Pair declares two names in one field spec — both become properties.",
			"properties": {
				"A": {
					"type": "string"
				},
				"B": {
					"type": "string"
				},
				"C": {
					"type": "integer"
				},
				"D": {
					"type": "integer"
				}
			},
			"required": [
				"A",
				"B"
			],
			"type": "object"
		},
		"Ratio": {
			"description": "Ratio is a float; the enumcode plugin overrides it with a number\nfragment carrying a const.",
			"type": "number"
		},
		"RightY": {
			"additionalProperties": true,
			"properties": {
				"Y": {
					"type": "integer"
				}
			},
			"required": [
				"Y"
			],
			"type": "object"
		},
		"Shadow": {
			"additionalProperties": true,
			"description": "Shadow exercises the shallower-wins rule: its explicit base_id field\nmust shadow the one promoted from Base, not be overwritten by it.",
			"properties": {
				"base_id": {
					"type": "string"
				}
			},
			"required": [
				"base_id"
			],
			"type": "object"
		},
		"ShallowX": {
			"additionalProperties": true,
			"properties": {
				"X": {
					"type": "integer"
				}
			},
			"required": [
				"X"
			],
			"type": "object"
		},
		"Status": {
			"description": "Status is the account status.",
			"enum": [
				"active",
				"paused",
				"deleted"
			],
			"type": "string"
		},
		"Stringified": {
			"additionalProperties": true,
			"description": "Stringified exercises the ,string tag option against plugin-override\nfragments: enum/const members stringify to their wire form (\"1\",\n\"1.5\", a double-encoded \"\"a\"\") and numeric-only bounds drop.",
			"properties": {
				"c": {
					"$ref": "#/$defs/Code"
				},
				"l": {
					"$ref": "#/$defs/Label"
				},
				"r": {
					"$ref": "#/$defs/Ratio"
				}
			},
			"required": [
				"c",
				"l",
				"r"
			],
			"type": "object"
		},
		"Tree": {
			"additionalProperties": true,
			"description": "Tree is a recursive type in the entry package.",
			"properties": {
				"label": {
					"type": "string"
				},
				"left": {
					"$ref": "#/$defs/Tree"
				},
				"right": {
					"$ref": "#/$defs/Tree"
				}
			},
			"required": [
				"label"
			],
			"type": "object"
		},
		"User": {
			"additionalProperties": true,
			"description": "User is the root fixture type.",
			"properties": {
				"active": {
					"$ref": "#/$defs/Interval"
				},
				"address": {
					"additionalProperties": true,
					"properties": {
						"city": {
							"type": "string"
						},
						"zip": {
							"type": "string"
						}
					},
					"required": [
						"city",
						"zip"
					],
					"type": "object"
				},
				"admin": {
					"type": "boolean"
				},
				"age": {
					"type": "integer"
				},
				"amount": {
					"description": "Amount in the smallest currency unit.",
					"type": "integer"
				},
				"balance": {
					"$ref": "#/$defs/Money"
				},
				"created_at": {
					"description": "stdlib type time.Time (walk stopped)"
				},
				"currency": {
					"description": "Currency code, e.g. \"JPY\".",
					"type": "string"
				},
				"email": {
					"type": "string"
				},
				"friends": {
					"items": {
						"$ref": "#/$defs/User"
					},
					"type": "array"
				},
				"id": {
					"$ref": "#/$defs/ID"
				},
				"metadata": {
					"additionalProperties": {
						"type": "string"
					},
					"type": "object"
				},
				"name": {
					"type": "string"
				},
				"scores": {
					"items": {
						"type": "number"
					},
					"type": "array"
				},
				"status": {
					"$ref": "#/$defs/Status"
				}
			},
			"required": [
				"active",
				"address",
				"admin",
				"age",
				"balance",
				"created_at",
				"id",
				"metadata",
				"name",
				"scores",
				"status"
			],
			"type": "object"
		},
		"ViaDeepX": {
			"additionalProperties": true,
			"properties": {
				"X": {
					"type": "string"
				}
			},
			"required": [
				"X"
			],
			"type": "object"
		},
		"Wrapper": {
			"additionalProperties": true,
			"properties": {
				"base_id": {
					"type": "string"
				},
				"note": {
					"type": "string"
				}
			},
			"required": [
				"base_id",
				"note"
			],
			"type": "object"
		}
	},
	"$schema": "http://json-schema.org/draft-07/schema#"
}

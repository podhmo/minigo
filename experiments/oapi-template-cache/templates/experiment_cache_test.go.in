package template

import (
	"bytes"
	"os"
	"path/filepath"
	"strings"
	"sync"
	"testing"
)

func TestExperimentCacheConcurrentAndCorrupt(t *testing.T) {
	dir := t.TempDir()
	t.Setenv("OAPI_TREE_CACHE", dir)
	const text = "prefix {{define \"child\"}}child{{end}}{{template \"child\"}}"
	var wg sync.WaitGroup
	for i := 0; i < 8; i++ {
		wg.Add(1)
		go func() {
			defer wg.Done()
			x, err := New("race").ExperimentParseCached(text)
			if err != nil {
				t.Error(err)
				return
			}
			var out bytes.Buffer
			if err = x.Execute(&out, nil); err != nil || out.String() != "prefix child" {
				t.Errorf("got %q err %v", out.String(), err)
			}
		}()
	}
	wg.Wait()
	entries, err := os.ReadDir(dir)
	if err != nil {
		t.Fatal(err)
	}
	if len(entries) != 1 || !strings.HasSuffix(entries[0].Name(), ".tree") {
		t.Fatalf("unexpected cache artifacts: %v", entries)
	}
	path := filepath.Join(dir, entries[0].Name())
	if err = os.WriteFile(path, []byte("corrupt snapshot"), 0600); err != nil {
		t.Fatal(err)
	}
	x, err := New("race").ExperimentParseCached(text)
	if err != nil {
		t.Fatal(err)
	}
	var out bytes.Buffer
	if err = x.Execute(&out, nil); err != nil || out.String() != "prefix child" {
		t.Fatalf("corrupt-cache fallback: %q %v", out.String(), err)
	}
	data, err := os.ReadFile(path)
	if err != nil || bytes.Equal(data, []byte("corrupt snapshot")) {
		t.Fatalf("corrupt cache was not replaced: %v", err)
	}
}

func TestExperimentCacheUnavailable(t *testing.T) {
	file := filepath.Join(t.TempDir(), "file")
	if err := os.WriteFile(file, []byte("not a directory"), 0600); err != nil {
		t.Fatal(err)
	}
	t.Setenv("OAPI_TREE_CACHE", file)
	x, err := New("unavailable").ExperimentParseCached("still works")
	if err != nil {
		t.Fatal(err)
	}
	var out bytes.Buffer
	if err = x.Execute(&out, nil); err != nil || out.String() != "still works" {
		t.Fatalf("unavailable-cache fallback: %q %v", out.String(), err)
	}
}
